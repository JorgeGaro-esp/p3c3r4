root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json,csv,cfg}]
indent_style = space
indent_size = 2

# El arte ASCII depende de los espacios finales y de la sangría exacta
[game/content/sprites/**]
trim_trailing_whitespace = false
indent_style = space

[*.md]
trim_trailing_whitespace = false
