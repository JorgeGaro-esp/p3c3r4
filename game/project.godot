; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="P3C3R4"
config/version="0.9.0"
run/main_scene="res://src/presentation/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/services/event_bus.gd"
Game="*res://src/services/game.gd"
SaveService="*res://src/services/save_controller.gd"
Settings="*res://src/services/settings.gd"
Platform="*res://src/services/platform.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/treat_warnings_as_errors=true

[display]

window/size/viewport_width=960
window/size/viewport_height=240
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/no_focus=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/fallback="es"
locale/translations=PackedStringArray("res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.es.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
